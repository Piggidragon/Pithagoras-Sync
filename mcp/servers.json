{
  "servers": [
    {
      "name": "computer-use-linux",
      "platform": "linux",
      "version": "TODO-PIN",
      "files": [
        {
          "arch": "x86_64",
          "kind": "executable",
          "path": "computer-use-linux",
          "url": "https://github.com/agent-sh/computer-use-linux/releases/download/TODO-PIN/computer-use-linux-x86_64"
        },
        {
          "arch": "aarch64",
          "kind": "executable",
          "path": "computer-use-linux",
          "url": "https://github.com/agent-sh/computer-use-linux/releases/download/TODO-PIN/computer-use-linux-aarch64"
        }
      ],
      "run": {
        "program": "computer-use-linux",
        "args": [],
        "env": {}
      },
      "allow": [
        "screenshot",
        "list_windows",
        "get_cursor_position",
        "mouse_move",
        "mouse_click",
        "mouse_scroll",
        "mouse_drag",
        "type_text",
        "press_key"
      ],
      "input": [
        "mouse_move",
        "mouse_click",
        "mouse_scroll",
        "mouse_drag",
        "type_text",
        "press_key"
      ],
      "focus": {
        "windows": {
          "tool": "list_windows"
        }
      },
      "selftest": {
        "screenshot": {
          "tool": "screenshot"
        },
        "pointer": {
          "position": {
            "tool": "get_cursor_position"
          },
          "move_to": {
            "tool": "mouse_move",
            "args": {
              "x": "$x",
              "y": "$y"
            }
          }
        }
      },
      "setup": [
        {
          "id": "accessibility",
          "title": "Accessibility (AT-SPI)",
          "text": "The server reads the window list through the accessibility bus (AT-SPI). GNOME switches it on with the setting org.gnome.desktop.interface toolkit-accessibility; applications started before the change see it after their next start.",
          "desktop": "gnome",
          "check": {
            "argv": [
              "/usr/bin/gsettings",
              "get",
              "org.gnome.desktop.interface",
              "toolkit-accessibility"
            ],
            "expect": "true"
          },
          "run": [
            "/usr/bin/gsettings",
            "set",
            "org.gnome.desktop.interface",
            "toolkit-accessibility",
            "true"
          ]
        },
        {
          "id": "shell-extension",
          "title": "The GNOME Shell extension",
          "text": "computer-use-linux targets windows through a GNOME Shell extension of its own (see its README for the pinned version). Install it as the README says, then log out and in again: GNOME Shell on Wayland loads a new extension only at login.",
          "desktop": "gnome"
        },
        {
          "id": "remote-desktop",
          "title": "Pointer and keyboard (the RemoteDesktop portal)",
          "text": "The first pointer or keyboard input asks through GNOME's remote desktop portal whether the server may control this desktop. Allow pointer and keyboard there; `pithagoras-sync computer-use test` triggers it.",
          "desktop": "gnome"
        },
        {
          "id": "kde",
          "title": "KDE Plasma (not validated)",
          "text": "computer-use-linux was validated on GNOME only. On KDE Plasma follow its README; the pointer and keyboard permission comes from Plasma's remote desktop portal. Pithagoras Sync has not tried this.",
          "desktop": "kde"
        }
      ]
    },
    {
      "name": "windows-mcp",
      "platform": "windows",
      "version": "TODO-PIN",
      "files": [
        {
          "arch": "x86_64",
          "kind": "zip",
          "path": "python",
          "url": "https://www.python.org/ftp/python/TODO-PIN/python-TODO-PIN-embed-amd64.zip"
        },
        {
          "arch": "x86_64",
          "kind": "wheel",
          "path": "python/Lib/site-packages",
          "url": "https://files.pythonhosted.org/packages/TODO-PIN/windows_mcp-TODO-PIN-py3-none-any.whl"
        }
      ],
      "write": [
        {
          "path": "python/pythonTODO-PIN._pth",
          "text": "pythonTODO-PIN.zip\r\n.\r\nLib\\site-packages\r\nimport site\r\n"
        }
      ],
      "run": {
        "program": "python/python.exe",
        "args": [
          "-m",
          "windows_mcp"
        ],
        "env": {
          "ANONYMIZED_TELEMETRY": "false",
          "PYTHONUTF8": "1"
        }
      },
      "allow": [
        "Snapshot",
        "Click",
        "Type",
        "Scroll",
        "Move",
        "Wait"
      ],
      "input": [
        "Click",
        "Type",
        "Scroll",
        "Move"
      ],
      "focus": {
        "windows": {
          "tool": "Snapshot"
        }
      },
      "selftest": {
        "screenshot": {
          "tool": "Snapshot",
          "args": {
            "use_vision": true
          }
        },
        "imports": [
          "windows_mcp"
        ]
      },
      "setup": [
        {
          "id": "session",
          "title": "Your desktop session",
          "text": "Windows-MCP drives your own desktop through UI Automation and needs no setup. It reaches only the session you are logged into: not a UAC prompt (the secure desktop), not another user's session and not the lock screen. While the screen is locked, calls fail."
        }
      ]
    }
  ]
}
